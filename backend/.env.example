# Backend Environment Variables Template for Render & Local

PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/furniture_erp?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=production

# Frontend Client URL(s) allowed by CORS
# For Render: set this to your Vercel frontend URL (e.g. https://your-project.vercel.app)
# You can also pass comma-separated URLs if you have custom domains:
# CLIENT_URL=https://your-project.vercel.app,https://www.yourdomain.com
CLIENT_URL=http://localhost:5173
